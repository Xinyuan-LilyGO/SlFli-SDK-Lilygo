config PKG_USING_AW21009
    bool "Enable AW21009 LED driver"
    default n
    select PKG_USING_I2C
    help
        Enable the AW21009 six-channel LED driver used by the
        T-SF32 Keyboard board.

if PKG_USING_AW21009

config AW21009_I2C_BUS_NAME
    string "I2C bus name"
    default "i2c1"

config AW21009_I2C_ADDR
    hex "AW21009 7-bit I2C address"
    range 0x20 0x27
    default 0x25
    help
        Address selected by the AW21009 AD0 and AD1 pins.

endif
