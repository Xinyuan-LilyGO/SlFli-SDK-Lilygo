config PKG_USING_BME280
    bool "Enable BME280 Sensor"
    default n

    if  PKG_USING_BME280
    
        config BME280_I2C_BUS_NAME
            string "I2C bus name"
            default "i2c1"

        config BME280_USING_RT_SENSOR
            bool "Register BME280 in RT-Thread Sensor framework"
            default n
            select RT_USING_SENSOR

        if BME280_USING_RT_SENSOR
            config BME280_RT_SENSOR_NAME
                string "RT-Thread Sensor device suffix"
                default "bme280"
        endif
    endif
