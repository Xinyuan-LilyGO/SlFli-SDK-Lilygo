config PKG_USING_ADS1115
    bool "Enable ADS1115 ADC driver"
    default n
    select PKG_USING_I2C
    select RT_USING_ADC
    help
        Enable support for the ADS1115 16-bit ADC.

if PKG_USING_ADS1115

config ADS1115_I2C_BUS_NAME
    string "I2C bus name"
    default "i2c1"

config ADS1115_I2C_ADDR
    int "ADS1115 7-bit I2C address"
    range 72 75
    default 72
    help
        Decimal address selected by the ADDR pin: GND=72 (0x48),
        VDD=73 (0x49), SDA=74 (0x4A), SCL=75 (0x4B).

config ADS1115_ADC_DEVICE_NAME
    string "RT-Thread ADC device name"
    default "ads1115"
    help
        Device name used by rt_device_find() and the FinSH adc command.

config ADS1115_ADC_DEFAULT_PGA
    int "Default PGA index for RT-Thread ADC reads"
    range 0 5
    default 1
    help
        0=6.144V, 1=4.096V, 2=2.048V, 3=1.024V,
        4=0.512V, 5=0.256V. The default supports 3.3V inputs.

config ADS1115_ADC_DEFAULT_RATE
    int "Default data-rate index for RT-Thread ADC reads"
    range 0 7
    default 4
    help
        0=8, 1=16, 2=32, 3=64, 4=128, 5=250,
        6=475, 7=860 samples per second.

endif
